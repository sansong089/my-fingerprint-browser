{
  "name": "my-fingerprint-browser",
  "version": "1.0.0",
  "description": "Multi-environment fingerprint browser based on Electron",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "prepare:fingerprint-browser": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-fingerprint-browser.ps1",
    "build": "npm run prepare:fingerprint-browser && vue-tsc --noEmit && vite build && electron-builder",
    "build:win": "npm run prepare:fingerprint-browser && vue-tsc --noEmit && vite build && electron-builder --win",
    "preview": "vite preview"
  },
  "dependencies": {
    "chrome-remote-interface": "^0.34.0",
    "electron-store": "^8.2.0",
    "fingerprint-generator": "^2.1.82",
    "lucide-vue-next": "^1.0.0",
    "uuid": "^9.0.1",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.25",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.18",
    "electron": "^29.1.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2",
    "vite": "^5.1.5",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vue-tsc": "^2.0.6"
  },
  "build": {
    "appId": "com.fingerprint.browser",
    "productName": "FingerprintBrowser",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/fingerprint-chromium",
        "to": "fingerprint-chromium",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true
    }
  }
}
